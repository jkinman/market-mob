# Market Mob Agent — Environment Variables
# Copy this to .env and fill in your actual keys

# Required: xAI API key for Grok LLM
XAI_API_KEY=your_xai_key_here

# Optional: Fallback LLM providers
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Sentiment scraping
# XURL_API_KEY=your_xurl_key_here

# Optional: YouTube RSS monitoring
# YOUTUBE_API_KEY=your_youtube_key_here
